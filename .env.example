# -------------------------------------------------------------
# DOREAR · Variables de Entorno para Analítica y Heatmaps
# -------------------------------------------------------------
# Cuando tengas el dominio registrado y la web subida,
# creá un archivo llamado `.env` en esta misma carpeta (o configuralas
# en el panel de Vercel > Settings > Environment Variables) y colocá los IDs:

# 1. Google Analytics 4 (Measurement ID de tu flujo web de GA4, formato G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# 2. Microsoft Clarity (Project ID de 10 caracteres alfanuméricos provisto por clarity.microsoft.com)
VITE_CLARITY_PROJECT_ID=
