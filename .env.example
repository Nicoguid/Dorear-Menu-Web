# -------------------------------------------------------------
# DOREAR · Variables de entorno (todas opcionales)
# -------------------------------------------------------------
# El código ya trae los valores de DOREAR por defecto. Solo hace falta
# cargarlas en Vercel (Settings > Environment Variables) para cambiarlos.

# Analítica (los IDs son públicos: viajan igual en el HTML)
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_CLARITY_PROJECT_ID=

# Supabase (la clave "publishable" es pública; la seguridad está en las funciones con PIN)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_IMAGES_BUCKET=

# Solo para el cron diario (api/rebuild.js). Son secretas: NO llevan el prefijo VITE_.
DEPLOY_HOOK_URL=
CRON_SECRET=
